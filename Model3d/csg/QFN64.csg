					multmatrix([[1, 0, 0, 0], [0, 1, 0, -6.42857], [0, 0, 1, 0], [0, 0, 0, 1]]) {
						text(text = "YYWWNNN", size = 0.642857, spacing = 1, font = "Liberation Serif", direction = "ltr", language = "en", script = "Latn", halign = "center", valign = "left", $fn = 64, $fa = 12, $fs = 2);
					}
				}
			}
		}
	}
}

